#!/usr/bin/env bash
#
#   Accende il sito DENTRO la stagione simulata, senza toccare la configurazione
#   di tutti i giorni.
#
#     ./vfoot-sim              avvia (scenario predefinito, g22-live)
#     ./vfoot-sim napoli-inter avvia su un altro scenario
#     ./vfoot-sim fine-stagione  l'ultima giornata di Serie A: campionato e coppe
#                                giocati fino in fondo, l'ultima giornata da
#                                concludere e i premi ancora da assegnare
#     ./vfoot-sim --at 2027-01-31T21:15:00+01:00
#     ./vfoot-sim status       che cosa gira, con che orologio
#     ./vfoot-sim stop         ferma tutto quello che ha avviato
#     ./vfoot-sim build        ricostruisce lo stato dello scenario, poi avvia
#     ./vfoot-sim reset        RIPORTA all'istante iniziale in pochi secondi
#     ./vfoot-sim resume       RIPRENDE da dove la serata era arrivata
#     ./vfoot-sim --lan        apre il banco AL TELEFONO sulla rete locale
#
#   PERCHE' ACCENDE ANCHE UN REDIS. In sviluppo, senza REDIS_URL, il layer dei
#   canali e' quello in memoria, che NON fa fan-out fra processi. Il cron dei tick
#   gira in un processo suo, quindi la spinta WebSocket dopo un import live finisce
#   nella memoria del cron e alla pagina aperta non arriva mai -- senza un errore da
#   nessuna parte, il che e' il modo peggiore in cui una cosa puo' non funzionare.
#   Se c'e' docker (o podman) ne accendiamo uno; se non c'e', lo si dice e la pagina
#   si aggiorna solo ricaricando.
#
#   QUANDO SERVE `build` E NON UN SEMPLICE AVVIO. Un riavvio riporta l'OROLOGIO
#   all'istante dello scenario, ma non i DATI: il cron intanto ha fatto camminare
#   la serata, e quello che ha scritto resta. Dopo mezz'ora di simulazione i due
#   divergono, e la forma che prende non e' ovvia -- una partita gia' promossa a
#   `data_ready` esce da `candidate_matches()`, quindi il tick non la tocca piu' e
#   resta "in corso" secondo la banca dati e non ancora cominciata secondo
#   l'orologio, con il tick che riferisce "nothing due" su tutto. Peggio se non e'
#   stata promossa: `_apply_status` riscrive il punteggio da quello che il provider
#   dice ADESSO, e un 1-0 torna 0-0.
#
#   Regola pratica: se il cron ha girato piu' di qualche minuto, `build`.
#
#   ...MA SOLO LA PRIMA VOLTA. `build` rigioca il campionato, che costa minuti, ed
#   e' un prezzo giusto per COSTRUIRE uno stato e assurdo per TORNARCI: lo stato e'
#   gia' stato costruito una volta, e uno scenario e' riproducibile per definizione.
#   Quindi `build` si lascia dietro un'ISTANTANEA della banca dati, e `reset` la
#   rimette al suo posto: stessi dati, stesso orologio, in pochi secondi invece che
#   in minuti. Provare qualcosa, sporcare la serata e ricominciare da capo torna a
#   costare quanto deve costare.
#
#   L'istantanea e' per (scenario, istante): `reset` riporta esattamente al punto da
#   cui quel `build` era partito, non a un generico "inizio".
#
#   RIPRENDERE NON E' RICOMINCIARE. `reset` torna all'INIZIO della serata, ed e' cio'
#   che si vuole dopo aver sporcato una prova. Dopo uno `stop` di solito si vuole
#   l'opposto -- continuare -- e un avvio semplice non lo fa: rimette l'orologio
#   all'istante dello scenario mentre i dati sono avanti di quanto si e' guardato, che
#   e' esattamente il caso che blocca tutto (vedi check_drift). Da qui `resume`, che
#   l'orologio non lo prende dallo scenario ma DAI DATI: l'ultimo timbro che una
#   partita porta, piu' un minuto.
#
#   Dai dati e non dall'orologio di quando si e' fermato -- che nessuno registra, e
#   che sarebbe comunque il numero sbagliato: sta fino a un intervallo di polling
#   oltre l'ultimo import, e ripartire di li' salterebbe il giro che quell'intervallo
#   doveva. La differenza fra i due sono i due minuti che si possono rigiocare.
#
#   `resume` non lascia un'istantanea e non ne consuma: sposta solo l'orologio. Per
#   poter tornare piu' volte a META' serata serve un `build --at <istante>`, che
#   quella l'istantanea la crea.
#
#   PROVARE DAL TELEFONO: `--lan`. I due server ascoltano gia' su 0.0.0.0, ma un
#   telefono che punta l'IP del portatile trova comunque tre porte chiuse in faccia,
#   e nessuna delle tre dice chiaramente perche':
#     - Django risponde 400 a un Host che non e' in ALLOWED_HOSTS;
#     - il browser blocca le chiamate perche' `http://<ip>:5173` non e' fra le
#       origini CORS;
#     - e soprattutto il frontend continuerebbe a chiamare `localhost:8000`, che
#       DAL TELEFONO e' il telefono stesso -- una app che sembra su ma e' vuota.
#   `--lan` esporta le tre variabili insieme, perche' due su tre non servono a
#   niente. Il terzo knob copre anche il WebSocket: `socketUrl()` deriva da
#   VITE_API_BASE_URL, quindi i voti live arrivano senza una variabile in piu'.
#
#   L'IP NON E' UN DETTAGLIO: E' L'IDENTITA' DELL'APP. Una PWA appartiene alla sua
#   origine -- service worker, cache, token in localStorage e iscrizione push sono
#   tutti per-origine. Se il DHCP cambia l'IP del portatile, `http://<altro-ip>:5173`
#   e' un'ALTRA app: l'icona vecchia resta sul telefono e non riceve piu' niente.
#   Per questo l'IP viene stampato a ogni avvio invece di essere ricordato da
#   qualche parte, e per questo si puo' fissare con VFOOT_LAN_IP=<ip>.
#
#   SERVE ANCORA UN PASSAGGIO SUL TELEFONO, una volta sola: senza HTTPS il browser
#   NON considera `http://<ip>:5173` un contesto sicuro, e `navigator.serviceWorker`
#   non esiste proprio -- niente worker, niente installazione, niente push, niente
#   offline. Si sana da Chrome del telefono, con l'eccezione per quell'origine
#   (chrome://flags, "Insecure origins treated as secure"): lo script stampa l'esatta
#   riga da incollare. E' l'alternativa ad `adb reverse` del doc, e non vuole il cavo.
#
#   ACCELERARE SI CHIEDE. Di default il banco e' IDENTICO alla produzione: stessa
#   cadenza (un giro ogni due minuti) e stessa forma (il passaggio pesante, quello
#   che scarica le heatmap, ogni quattro giri). Un banco che di default differisce
#   dal prodotto mente di default, e chi ci guarda dentro non ha modo di saperlo.
#   Non serve nemmeno: i voti si muovono sul giro LEGGERO, cioe' gia' ogni due
#   minuti. Resta lungo solo il pesante (otto minuti), e lo si aspetta solo quando
#   si sta guardando proprio quello -- le zone, aura, il rientro dell'esposizione
#   difensiva. Per quel caso, e solo per quello, si chiede:
#
#       VFOOT_LIVE_POLL_MINUTES=1 ./vfoot-sim napoli-inter    # il TEMPO
#       VFOOT_LIVE_HEAVY_EVERY=2 ./vfoot-sim napoli-inter     # la FORMA
#
#   Le due manopole sono di natura diversa e vanno tenute separate: il tempo dice
#   quanto in fretta scorre, k dice com'e' fatto il comportamento. Un banco a k=1
#   non potrebbe mostrare l'unico comportamento nuovo che interessa -- il voto
#   provvisorio senza esposizione difensiva che si assesta al giro pesante.
#
#   IL .env NON VIENE MODIFICATO. Le variabili vengono ESPORTATE nell'ambiente dei
#   processi che questo script avvia, e vincono su quelle del file: load_dotenv
#   non sovrascrive l'ambiente. E' la stessa proprieta' che rende insidioso un
#   `export` dimenticato in una shell -- qui la si usa apposta.
#
#   Perche' uno script separato invece di due righe a mano: le variabili devono
#   valere per DUE processi (il server e il cron dei tick) avviati a pochi secondi
#   di distanza, perche' ognuno calcola il proprio scarto dall'ora vera quando
#   parte. Avviarli a mano in due momenti diversi li lascia con due orologi
#   diversi, e il sintomo -- una partita che al server risulta finita e al cron no
#   -- non assomiglia per niente alla causa.
#
#   Funziona in Git Bash su Windows e su Linux: niente ss, setsid o /proc, che
#   sono il motivo per cui ./vfoot-dev ha dovuto avere un gemello PowerShell.
#
set -uo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LOGDIR="${TMPDIR:-/tmp}/vfoot-sim"
PIDFILE="$LOGDIR/pids"
BACK_PORT=8000
FRONT_PORT=5173
REDIS_PORT=6379
REDIS_NAME=vfoot-sim-redis
# Le chiavi VAPID della SIMULAZIONE, tenute fuori dal repo e fuori dal .env: sono
# di questo script e di nessun altro, e un push di prova non deve poter partire con
# le chiavi di produzione. Sotto ~/.cache e non sotto /tmp perche' rigenerarle
# invalida le iscrizioni gia' fatte (il browser lega la subscription alla chiave
# pubblica che ha ricevuto) e ci si ritroverebbe a ri-autorizzare le notifiche a
# ogni riavvio della macchina.
VAPID_FILE="${XDG_CACHE_HOME:-$HOME/.cache}/vfoot-sim/vapid"
# Le istantanee stanno accanto alle chiavi e non sotto /tmp: sono grandi (centinaia
# di MB) e devono sopravvivere a un riavvio della macchina, altrimenti la prima
# simulazione della giornata ricomincia dai minuti di `build` -- che e' esattamente
# cio' che questa faccenda esiste per evitare.
SNAPDIR="${XDG_CACHE_HOME:-$HOME/.cache}/vfoot-sim/snapshots"

# Lo scenario e l'istante predefiniti: gli stessi che `manage.py simulate_scenario
# --list` descrive. Cambiarli qui NON basta -- li' c'e' la definizione vera.
SCENARIO="g22-live"
AT=""
# Acceso da --lan: apre il banco all'IP di rete del portatile, per provarlo dal
# telefono. Spento, niente cambia -- il banco resta su localhost com'e' sempre stato.
LAN=""
LAN_IP="${VFOOT_LAN_IP:-}"
# Chi possiede la lega dello scenario, e se ha anche le coppe. Valgono al momento
# di SEMINARE, cioe' con `build`: un avvio semplice non ricostruisce niente, e una
# lega gia' seminata non cambia proprietario perche' glielo si chiede all'avvio.
OWNER=""
CUP=""
# Acceso da start_frontend quando il frontend riusato serve ancora la base URL di
# localhost: l'indirizzo per il telefono c'e', ma non e' ancora buono.
LAN_STALE=""
# Acceso da start_redis quando un Redis non c'e' e non si puo' accendere: da li' in
# poi il tick non e' piu' un processo a parte, ma un thread del server.
TICK_IN_PROCESS=""

BOLD=$'\033[1m'; DIM=$'\033[2m'; OK=$'\033[32m'; WARN=$'\033[33m'; ERR=$'\033[31m'; X=$'\033[0m'
die()  { printf '%serrore:%s %s\n' "$ERR" "$X" "$*" >&2; exit 1; }
say()  { printf '  %s\n' "$*"; }

# --- python del venv, con i due layout possibili --------------------------
PY="$REPO/vfoot-backend/.venv/Scripts/python.exe"
[ -x "$PY" ] || PY="$REPO/vfoot-backend/.venv/bin/python"
[ -x "$PY" ] || die "python del venv non trovato sotto vfoot-backend/.venv"
MANAGE="$REPO/vfoot-backend/src/manage.py"

# --- porte, senza ss ------------------------------------------------------
port_busy() {
  "$PY" - "$1" <<'EOF' 2>/dev/null
import socket, sys
s = socket.socket()
s.settimeout(0.4)
sys.exit(0 if s.connect_ex(("127.0.0.1", int(sys.argv[1]))) == 0 else 1)
EOF
}

wait_port() { # porta secondi
  local i=0
  while [ "$i" -lt "$2" ]; do
    port_busy "$1" && return 0
    sleep 1; i=$((i + 1))
  done
  return 1
}

kill_port() { # porta etichetta -- chiude anche cio' che NON abbiamo avviato noi
  port_busy "$1" || return 0
  if command -v taskkill.exe >/dev/null 2>&1; then
    # Windows: la coppia netstat/taskkill e' l'unica strada che non richiede
    # strumenti che Git Bash non ha.
    local pids
    pids=$(netstat -ano 2>/dev/null | grep -E "LISTENING" | grep ":$1 " \
           | awk '{print $NF}' | sort -u)
    for p in $pids; do taskkill.exe //PID "$p" //F >/dev/null 2>&1 || true; done
  else
    local pids
    pids=$(lsof -ti ":$1" 2>/dev/null || true)
    [ -n "$pids" ] && kill -9 $pids 2>/dev/null || true
  fi
  sleep 1
  port_busy "$1" && { printf '%s%s occupata e non si libera%s\n' "$WARN" "$1" "$X" >&2; return 1; }
  say "porta $1 liberata"
}

# --- redis: il fan-out fra il cron e il server ------------------------------
container_cmd() {
  for c in docker podman; do
    command -v "$c" >/dev/null 2>&1 && "$c" info >/dev/null 2>&1 && { echo "$c"; return 0; }
  done
  return 1
}

start_redis() {
  if port_busy "$REDIS_PORT"; then
    say "redis     gia' in ascolto sulla $REDIS_PORT, lasciato com'e'"
    export REDIS_URL="redis://127.0.0.1:$REDIS_PORT/1"
    return 0
  fi
  local ct
  ct=$(container_cmd) || {
    # Niente Redis: invece di rinunciare alla spinta, si toglie di mezzo la ragione
    # per cui serviva. Il layer in memoria non attraversa i PROCESSI, quindi il tick
    # va a girare DENTRO il server -- stesso processo, stesso layer, spinta che
    # arriva. Vale solo in sviluppo (vedi realdata/services/tick_thread.py).
    TICK_IN_PROCESS=1
    printf '%sniente docker:%s il tick girera'"'"' DENTRO il server, cosi'"'"' la spinta\n' "$WARN" "$X"
    printf '  WebSocket arriva lo stesso senza Redis (solo in sviluppo).\n'
    return 0
  }
  # --rm: il contenitore e' usa-e-getta come la simulazione. Se resta in giro, il
  # prossimo avvio trova la porta occupata e lo riusa, che va bene lo stesso.
  "$ct" run -d --rm --name "$REDIS_NAME" -p "$REDIS_PORT:6379" redis:7-alpine \
    > "$LOGDIR/redis.log" 2>&1 || {
      printf '%sredis non partito%s (vedi %s/redis.log)\n' "$WARN" "$X" "$LOGDIR"; return 0; }
  wait_port "$REDIS_PORT" 20 || { printf '%sredis non risponde%s\n' "$WARN" "$X"; return 0; }
  : > "$LOGDIR/started-redis"
  export REDIS_URL="redis://127.0.0.1:$REDIS_PORT/1"
  say "redis      $REDIS_URL  (spinte WebSocket fra cron e server)"
}

# --- chiavi push ------------------------------------------------------------
load_vapid() {
  mkdir -p "$(dirname "$VAPID_FILE")"
  if [ ! -s "$VAPID_FILE" ]; then
    "$PY" "$MANAGE" vapid_keys 2>/dev/null | grep '^VFOOT_VAPID_' > "$VAPID_FILE.tmp" \
      && mv "$VAPID_FILE.tmp" "$VAPID_FILE" \
      || { rm -f "$VAPID_FILE.tmp"; printf '%schiavi VAPID non generate: le notifiche push restano spente%s\n' "$WARN" "$X"; return 0; }
    say "push      chiavi VAPID generate in $VAPID_FILE"
  fi
  # shellcheck disable=SC2046
  set -a; . "$VAPID_FILE"; set +a
  export VFOOT_VAPID_SUBJECT="mailto:simulazione@vfoot.it"
}

# --- istantanee della banca dati ------------------------------------------
# Il percorso lo CHIEDIAMO a Django invece di scriverlo qui: e' una sola riga di
# configurazione, ma duplicarla vorrebbe dire che il giorno in cui cambia questo
# script copia allegramente il file sbagliato senza dirlo a nessuno.
db_path() {
  "$PY" "$MANAGE" shell -c \
    "from django.conf import settings; print(settings.DATABASES['default']['NAME'])" \
    2>/dev/null | tail -1
}

# I due punti e il piu' dell'ora ISO non sono ammessi in un nome di file su
# Windows: senza questa sostituzione la copia fallisce, e fallisce solo li'.
snap_file() { printf '%s/%s@%s.sqlite3' "$SNAPDIR" "$SCENARIO" "$(printf '%s' "$AT" | tr ':+' '--')"; }

save_snapshot() {
  local db snap
  db=$(db_path); snap=$(snap_file)
  [ -n "$db" ] && [ -f "$db" ] || {
    printf '%sistantanea non salvata%s: banca dati non trovata (`reset` non funzionera`)\n' "$WARN" "$X"
    return 0; }
  mkdir -p "$SNAPDIR"
  # Su un temporaneo e poi mv: se la copia si interrompe a meta' non vogliamo
  # lasciare al posto dell'istantanea buona un file mutilo che `reset` ripristina
  # come se niente fosse.
  cp "$db" "$snap.tmp" && mv "$snap.tmp" "$snap" || {
    rm -f "$snap.tmp"
    printf '%sistantanea non salvata%s\n' "$WARN" "$X"; return 0; }
  # L'istante dell'ultimo `build` di questo scenario, perche' `reset` possa tornare
  # DA DOVE SI ERA PARTITI. Senza, un `build --at` metteva l'istantanea a un'ora e
  # `reset` la cercava a quella predefinita dello scenario: due comandi della stessa
  # coppia che non parlano della stessa serata.
  printf '%s' "$AT" > "$SNAPDIR/$SCENARIO.last"
  say "istantanea $(du -h "$snap" 2>/dev/null | cut -f1)  ($snap)"
}

# --- l'orologio e i dati possono non parlare della stessa serata -----------
# Un avvio semplice rimette l'OROLOGIO all'istante dello scenario e non tocca i
# DATI: basta cambiare scenario, o riprendere la serata di ieri lasciata a meta',
# perche' i due finiscano a ore diverse. Nel verso "dati indietro" non succede
# niente di male -- il tick recupera. Nel verso opposto il sintomo e' MUTO: il cron
# gira, riferisce "nothing due" e la pagina non si muove, perche' la cadenza
# confronta `now - data_checked_at` con l'intervallo e quella differenza e'
# NEGATIVA. Sono le stesse parole che il tick usa quando ha ragione, e da fuori non
# si distinguono: e' costato mezz'ora passata a guardare una pagina ferma con tutto
# acceso e in ordine. Quindi lo si dice qui, all'avvio, prima che si guardi.
#
# L'istante si passa dentro come VFOOT_FAKE_NOW, cioe' con la stessa manopola che
# sposta l'orologio di tutto il resto: il processo che controlla guarda esattamente
# da dove guarda il server, e non c'e' un secondo modo di dire "adesso" che possa
# divergere dal primo.
check_drift() { # [istante ISO; vuoto = quello gia' esportato] [scenario da suggerire]
  local gap what="${2:-$SCENARIO}"
  gap=$(VFOOT_FAKE_NOW="${1:-${VFOOT_FAKE_NOW:-}}" "$PY" "$MANAGE" shell -c \
    "from django.utils import timezone
from realdata.services.match_scheduler import clock_drift, human_gap
d = clock_drift(timezone.now())
print(human_gap(d) if d else '')" 2>/dev/null | tail -1)
  [ -n "$gap" ] || return 0
  printf "\n%sATTENZIONE: la banca dati e' AVANTI all'orologio di %s.%s\n" "$ERR" "$gap" "$X"
  printf "  Un timbro registra qualcosa di OSSERVATO, e nel futuro non si osserva\n"
  printf "  niente: questo scenario e' ripartito su dati che una simulazione\n"
  printf "  precedente aveva gia' portato piu' avanti. Il tick dira' \"nothing due\"\n"
  printf "  e la pagina restera' ferma per tutte le %s che mancano.\n" "$gap"
  printf "%s      ./vfoot-sim reset %s   ripristina l'istantanea (secondi)%s\n" "$DIM" "$what" "$X"
  printf "%s      ./vfoot-sim build %s   ricostruisce da zero (minuti)%s\n" "$DIM" "$what" "$X"
}

# --- avvio ----------------------------------------------------------------
detect_lan_ip() {
  # Gia' scelto a mano: si crede all'utente e non si va a cercare. E' anche l'unica
  # via su una macchina con piu' interfacce plausibili (docker0, anbox0, una VPN),
  # dove indovinare vuol dire indovinare male una volta su tre.
  [ -n "$LAN_IP" ] && return 0
  # L'IP con cui si esce, non "tutti gli IP": e' quello che il telefono puo'
  # raggiungere, ed e' l'unico che la tabella di routing sa nominare da sola. Non
  # apre connessioni -- 1.1.1.1 e' un pretesto per farsi dire da dove uscirebbe.
  LAN_IP=$(ip route get 1.1.1.1 2>/dev/null | sed -n 's/.* src \([0-9.]*\).*/\1/p' | head -1)
  # Windows (Git Bash): niente `ip`. Qui la sorgente e' ipconfig, e si prende il
  # primo IPv4 che non sia loopback.
  [ -n "$LAN_IP" ] || LAN_IP=$(ipconfig 2>/dev/null \
    | sed -n 's/.*IPv4[^:]*: *\([0-9.]*\).*/\1/p' | grep -v '^127\.' | head -1)
  [ -n "$LAN_IP" ] || die "non riesco a capire l'IP di rete di questa macchina.
  Dimmelo a mano:  VFOOT_LAN_IP=192.168.1.42 ./vfoot-sim --lan"
}

export_sim_env() {
  # L'istante: quello passato con --at, altrimenti quello dello scenario, letto
  # dalla sua definizione invece che duplicato qui.
  if [ -z "$AT" ]; then
    AT=$("$PY" "$MANAGE" shell -c \
      "from vfoot.management.commands.simulate_scenario import SCENARIOS; \
       print(SCENARIOS['$SCENARIO'].at)" 2>/dev/null | tail -1)
  fi
  [ -n "$AT" ] || die "scenario '$SCENARIO' sconosciuto (prova: $PY $MANAGE simulate_scenario --list)"
  export VFOOT_FAKE_NOW="$AT"
  export VFOOT_EGRESS_SIMULATED=true
  # L'ALTRA uscita. Il .env di sviluppo punta al relay Brevo vero, quindi provare
  # la registrazione o il recupero password dal banco manda posta VERA all'indirizzo
  # che si e' scritto nel form -- e un indirizzo inventato rimbalza. I rimbalzi non
  # si limitano a non arrivare: sono la misura con cui un relay decide se sei un
  # mittente serio, e quella reputazione e' condivisa col dominio da cui scrivono le
  # notifiche vere. Qui la posta si stampa e basta, com'e' gia' per lo scraping.
  # Per provare la consegna davvero, una volta e verso un indirizzo che esiste:
  #     VFOOT_SIM_REAL_EMAIL=1 ./vfoot-sim
  if [ -z "${VFOOT_SIM_REAL_EMAIL:-}" ]; then
    export DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
  fi
  if [ -n "$LAN" ]; then
    detect_lan_ip
    # AGGIUNTI ai valori buoni, non sostituiti: il banco deve restare usabile dal
    # portatile mentre il telefono lo guarda. Sostituirli spegnerebbe localhost, che
    # e' l'origine da cui si sviluppa.
    export DJANGO_ALLOWED_HOSTS="localhost,127.0.0.1,testserver,$LAN_IP"
    export DJANGO_CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://$LAN_IP:$FRONT_PORT"
    # La riga che fa la differenza fra un'app viva e un guscio vuoto. Vince sul
    # .env.local (Vite antepone le variabili di processo a quelle del file), quindi
    # non c'e' niente da modificare e niente da ricordare di rimettere a posto.
    export VITE_API_BASE_URL="http://$LAN_IP:$BACK_PORT/api/v1"
  fi
  # NESSUNA cadenza forzata qui: il banco gira con la stessa di produzione (un
  # giro ogni due minuti, il passaggio pesante ogni quattro giri). Vedi la nota
  # ACCELERARE in cima.
}

start_backend() {
  mkdir -p "$LOGDIR"
  # Deve valere per il PROCESSO DEL SERVER, quindi si esporta qui e non altrove:
  # e' il server che ospitera' il tick.
  [ -n "$TICK_IN_PROCESS" ] && export VFOOT_TICK_IN_PROCESS=true VFOOT_TICK_EVERY=60
  # -u come per il cron, e per la stessa ragione: quando il tick gira DENTRO questo
  # processo, quello che stampa finisce qui. Senza, python bufferizza lo stdout (non
  # e' un terminale) e le righe del tick restano invisibili per mezz'ora -- durante
  # questa sessione ha fatto sembrare che il tick non stesse girando affatto, mentre
  # stava importando regolarmente. Il logging si scarica da solo ed e' per questo che
  # si vedeva solo lui: due meta' dello stesso log con due comportamenti diversi.
  # Il log del giro PRECEDENTE si mette da parte invece di sovrascriverlo. Quando
  # qualcosa si inchioda, la prima cosa che si fa e' riavviare -- e con la vecchia
  # riga quel riavvio cancellava l'unica traccia di che cosa fosse successo. E'
  # gia' costato una diagnosi: un server al 270% di CPU con ogni richiesta appesa,
  # e nessun modo di sapere piu' quali richieste fossero in volo.
  [ -f "$LOGDIR/backend.log" ] && mv -f "$LOGDIR/backend.log" "$LOGDIR/backend.log.1"
  ( cd "$REPO/vfoot-backend/src" \
    && nohup "$PY" -u manage.py runserver "0.0.0.0:$BACK_PORT" --noreload \
       > "$LOGDIR/backend.log" 2>&1 < /dev/null & echo $! >> "$PIDFILE" )
  wait_port "$BACK_PORT" 45 \
    || { tail -20 "$LOGDIR/backend.log" >&2; die "backend non partito"; }
  say "backend   http://localhost:$BACK_PORT  (anche dall'IP di rete, per il telefono)"
  if [ -n "${VFOOT_SIM_REAL_EMAIL:-}" ]; then
    printf '%s  email      ESCONO DAVVERO (relay vero): scrivi solo indirizzi che esistono%s\n' "$WARN" "$X"
  else
    say "email     stampate qui, non spedite  ($LOGDIR/backend.log)"
  fi
}

start_ticks() {
  if [ -n "$TICK_IN_PROCESS" ]; then
    # Avviarlo anche qui vorrebbe dire DUE scheduler sulla stessa banca dati, che si
    # contendono gli stessi import: il secondo trova sempre "nothing due" e ogni
    # tanto i due si pestano su una scrittura.
    say "cron      dentro il server (log: $LOGDIR/backend.log)"
    return 0
  fi
  mkdir -p "$LOGDIR"
  # -u: senza, python bufferizza lo stdout quando non e' un terminale, e un log
  # che si riempie a blocchi di qualche kilobyte resta vuoto per mezz'ora. Questo
  # e' l'unico log che si guarda mentre scorre, quindi e' l'unico dove conta.
  ( cd "$REPO/vfoot-backend/src" \
    && nohup "$PY" -u manage.py tick_loop \
       > "$LOGDIR/tick.log" 2>&1 < /dev/null & echo $! >> "$PIDFILE" )
  say "cron      un tick al minuto  ($LOGDIR/tick.log)"
}

# Che cosa sta DAVVERO servendo il frontend acceso, non cosa gli avremmo detto di
# servire. VITE_API_BASE_URL si fissa all'avvio di Vite: un frontend gia' in piedi da
# un avvio senza --lan continua a dire `localhost:8000`, e dal telefono quello e' il
# telefono. E' il guaio peggiore dei tre perche' e' l'unico che non si vede -- l'app
# si apre, si naviga, ed e' vuota -- e senza questo controllo lo script stampava
# l'indirizzo per il telefono affermando che era tutto a posto.
# 0 = giusto, 1 = sbagliato, 2 = non si e' potuto guardare (che non e' un verdetto).
lan_base_url_ok() {
  "$PY" - "$FRONT_PORT" "$LAN_IP" <<'EOF' 2>/dev/null
import sys, urllib.request
port, ip = sys.argv[1], sys.argv[2]
try:
    body = urllib.request.urlopen(
        "http://127.0.0.1:%s/src/api/backend.ts" % port, timeout=8
    ).read().decode("utf-8", "replace")
except Exception:
    sys.exit(2)
sys.exit(0 if '"VITE_API_BASE_URL": "http://%s:' % ip in body else 1)
EOF
}

# Le dipendenze installate sono piu' vecchie di quelle dichiarate? npm scrive
# node_modules/.package-lock.json a ogni install, quindi il confronto e' fra due
# timbri e non costa niente. Serve DOPO UN PULL: un commit che aggiunge una libreria
# non la installa, e Vite se ne accorge solo quando qualcuno apre la pagina -- che
# col telefono vuol dire accorgersene dall'altra parte della stanza, davanti a un
# overlay rosso che parla di percorsi del portatile. E' successo con lucide-react.
# Si avvisa e basta, non si installa: scaricare pacchetti e' un'azione di rete, e
# chi sta lavorando sull'hotspot del telefono la paga a consumo.
check_frontend_deps() {
  local lock="$REPO/vfoot-frontend/package-lock.json"
  local installed="$REPO/vfoot-frontend/node_modules/.package-lock.json"
  if [ ! -d "$REPO/vfoot-frontend/node_modules" ]; then
    printf '%s  le dipendenze del frontend non sono mai state installate:%s\n' "$WARN" "$X"
    printf '%s      (cd vfoot-frontend && npm install)%s\n' "$DIM" "$X"
    return 0
  fi
  [ -f "$lock" ] && [ -f "$installed" ] || return 0
  if [ "$lock" -nt "$installed" ]; then
    cat <<EOF
${WARN}  package-lock.json e' piu' recente di cio' che c'e' in node_modules: dopo un
  pull che aggiunge una libreria, la pagina si apre su un errore di import.${X}
${DIM}      (cd vfoot-frontend && npm install)${X}
EOF
  fi
}

start_frontend() {
  check_frontend_deps
  if port_busy "$FRONT_PORT"; then
    say "frontend  gia' in ascolto sulla $FRONT_PORT, lasciato com'e'"
    if [ -n "$LAN" ]; then
      lan_base_url_ok; case $? in
        0) say "dal telefono  http://$LAN_IP:$FRONT_PORT" ;;
        2) printf '%s  non ho potuto controllare che base URL serve: guardalo a mano%s\n' "$WARN" "$X" ;;
        *) LAN_STALE=1; cat <<EOF
${WARN}  ma NON per il telefono: quel frontend e' partito senza --lan e chiama ancora
  localhost:8000 -- che dal telefono e' il telefono. L'app si aprirebbe viva e
  vuota. Riavvialo:  ./vfoot-sim stop && ./vfoot-sim --lan${X}
EOF
           ;;
      esac
    fi
    return 0
  fi
  # Lasciata come traccia per `stop`: chiudere una porta che non abbiamo aperto
  # noi vorrebbe dire spegnere il frontend avviato con ./vfoot-dev, che e'
  # esattamente cio' che questo script promette di non toccare.
  : > "$LOGDIR/started-frontend"
  local npm_bin=npm
  command -v npm >/dev/null 2>&1 || {
    # Node qui e' installato come zip nella cartella utente (l'MSI vuole
    # l'amministratore): stessa ricerca che fa vfoot-dev.ps1.
    npm_bin=$(ls -d "$LOCALAPPDATA/Programs/node-v"*/npm.cmd 2>/dev/null | head -1)
    [ -n "$npm_bin" ] || { printf '%snpm non trovato: avvia il frontend a mano%s\n' "$WARN" "$X"; return 0; }
  }
  mkdir -p "$LOGDIR"
  ( cd "$REPO/vfoot-frontend" \
    && nohup "$npm_bin" run dev -- --host 0.0.0.0 --port "$FRONT_PORT" \
       > "$LOGDIR/frontend.log" 2>&1 < /dev/null & echo $! >> "$PIDFILE" )
  wait_port "$FRONT_PORT" 45 \
    || { tail -20 "$LOGDIR/frontend.log" >&2; printf '%sfrontend non partito%s\n' "$WARN" "$X"; return 0; }
  say "frontend  http://localhost:$FRONT_PORT"
  [ -n "$LAN" ] && say "dal telefono  http://$LAN_IP:$FRONT_PORT"
  return 0
}

# Le istruzioni per il telefono, stampate a ogni avvio con --lan e non scritte in un
# doc: contengono l'IP di OGGI, e un doc con dentro l'IP di ieri e' peggio di niente.
say_phone_steps() {
  # Il colore dice se l'indirizzo e' pronto o se sopra c'e' un guaio da sanare
  # prima: stamparlo in verde dopo un avviso vorrebbe dire dare due risposte
  # opposte alla stessa domanda, e la seconda e' quella che si ricorda.
  if [ -n "$LAN_STALE" ]; then
    printf '\n%sdal telefono%s  %shttp://%s:%s%s  %s(prima riavvia il frontend, vedi sopra)%s\n' \
      "$BOLD" "$X" "$WARN" "$LAN_IP" "$FRONT_PORT" "$X" "$DIM" "$X"
  else
    printf '\n%sdal telefono%s  %shttp://%s:%s%s\n' "$BOLD" "$X" "$OK" "$LAN_IP" "$FRONT_PORT" "$X"
  fi
  cat <<EOF
${DIM}  Una volta sola, su Chrome del telefono. Senza, la pagina si apre ma NON e' un
  contesto sicuro: navigator.serviceWorker non esiste proprio, quindi niente
  installazione, niente push, niente offline -- e nessun errore che lo dica.${X}
    1. apri  ${BOLD}chrome://flags/#unsafely-treat-insecure-origin-as-secure${X}
    2. incolla nella casella  ${BOLD}http://$LAN_IP:$FRONT_PORT${X}
    3. il menu a fianco su ${BOLD}Enabled${X}, poi ${BOLD}Relaunch${X}
${DIM}  Per sapere se ha funzionato, dal telefono:${X}
    ${BOLD}http://$LAN_IP:$FRONT_PORT/pwa-check.html${X}
${DIM}  Una riga verde o rossa e il motivo. E' servita dalla stessa origine perche' il
  contesto sicuro e' una proprieta' dell'origine, e non chiede di accedere.${X}
EOF
}

# --- comandi --------------------------------------------------------------
cmd_start() {
  export_sim_env
  printf '%sscenario %s%s  orologio simulato: %s%s%s\n' \
    "$BOLD" "$SCENARIO" "$X" "$OK" "$VFOOT_FAKE_NOW" "$X"
  mkdir -p "$LOGDIR"; : > "$PIDFILE"; rm -f "$LOGDIR/started-frontend" "$LOGDIR/started-redis"
  kill_port "$BACK_PORT" || true
  # Prima del backend e del cron: le variabili devono valere per entrambi, ed e'
  # esattamente la coppia di processi che deve trovarsi sullo stesso layer.
  start_redis
  load_vapid
  start_backend
  start_ticks
  start_frontend
  say_league
  printf '\n%sl orologio CAMMINA: da qui in poi il tempo passa come quello vero.%s\n' "$DIM" "$X"
  printf '%sper fermare tutto: ./vfoot-sim stop%s\n' "$DIM" "$X"
  [ -n "$LAN" ] && say_phone_steps
  # Per ULTIMO, e non prima del backend: e' l'unica riga che chiede di fare
  # qualcosa, e sopra a mezza pagina di avvii sarebbe la prima a scorrere via.
  # Dopo un `build` o un `reset` non trova mai niente, e i due secondi che costa
  # sono il prezzo di non avere due strade diverse per accendere.
  check_drift
}

cmd_build() {
  export_sim_env
  printf '%sricostruisco lo scenario %s a %s%s\n' "$BOLD" "$SCENARIO" "$VFOOT_FAKE_NOW" "$X"
  # Passate SOLO qui, e non a `start`: sono decisioni di semina. Una lega gia'
  # seminata non cambia proprietario ne' guadagna una coppa perche' lo si chiede a
  # un avvio, e accettare le opzioni li' vorrebbe dire lasciarle ignorare in
  # silenzio -- il tipo di bugia che questo script esiste per non dire.
  local extra=()
  [ -n "$OWNER" ] && extra+=(--owner "$OWNER")
  [ -n "$CUP" ] && extra+=(--cup)
  "$PY" "$MANAGE" simulate_scenario --scenario "$SCENARIO" --at "$VFOOT_FAKE_NOW" \
    "${extra[@]}" \
    || die "ricostruzione fallita"
  # PRIMA di accendere: da qui in poi il cron scrive, e un'istantanea presa a
  # simulazione avviata conterrebbe gia' qualche minuto di serata giocata.
  save_snapshot
  cmd_start
}

cmd_resume() {
  # L'orologio dai DATI. La domanda non e' "che ora e'" ma "fin dove si e' giocato",
  # quindi questo processo NON ha bisogno di un orologio simulato per rispondere: e'
  # cio' che rompe l'uovo e la gallina, visto che l'istante da esportare e' proprio
  # quello che stiamo cercando.
  #
  # Piu' un minuto, coi secondi azzerati: l'istante cosi' costruito e' sempre DOPO
  # l'ultimo timbro (fra 1 e 60 secondi), che e' il verso innocuo. Prenderlo esatto
  # o per difetto rimetterebbe l'orologio dentro i dati gia' scritti, cioe' nel
  # guaio da cui `resume` esiste per uscire.
  #
  # Scritto nel fuso della Serie A e non in UTC: e' il fuso in cui sono scritti gli
  # scenari e l'unico in cui l'ora letta corrisponde a quella che si vede a schermo.
  # Se il sistema non ha le tabelle dei fusi si ripiega su UTC, che e' meno leggibile
  # ma non e' mai ambiguo.
  AT=$("$PY" "$MANAGE" shell -c "
from datetime import timedelta, timezone as dt_timezone
from realdata.services.match_scheduler import data_high_water
top = data_high_water()
if top:
    try:
        from zoneinfo import ZoneInfo
        top = top.astimezone(ZoneInfo('Europe/Rome'))
    except Exception:
        pass
    print((top + timedelta(minutes=1)).replace(second=0, microsecond=0).isoformat())" \
    2>/dev/null | tail -1)
  [ -n "$AT" ] || die "nessun timbro nella banca dati: non c'e' una serata da riprendere.
  E' il caso di una banca dati mai importata -- serve un \`./vfoot-sim build\`."
  printf '%sriprendo da dove la serata era arrivata%s\n' "$BOLD" "$X"
  cmd_start
}

cmd_reset() {
  # L'istante predefinito di `reset` e' quello dell'ULTIMO `build`, non quello dello
  # scenario: si torna da dove si e' partiti, che e' l'unica cosa che "reset" possa
  # ragionevolmente voler dire. Un `--at` esplicito vince, per tornare a un istante
  # costruito in precedenza.
  [ -n "$AT" ] || [ ! -s "$SNAPDIR/$SCENARIO.last" ] || AT=$(cat "$SNAPDIR/$SCENARIO.last")
  export_sim_env
  local snap db
  snap=$(snap_file)
  [ -f "$snap" ] || die "nessuna istantanea per '$SCENARIO' a $AT.
  Serve un \`./vfoot-sim build\` una volta sola: e' quello che la crea.$(
     ls "$SNAPDIR"/*.sqlite3 >/dev/null 2>&1 && printf '\n  Disponibili:\n%s' \
       "$(ls -1 "$SNAPDIR"/*.sqlite3 | sed 's|.*/|    |;s|\.sqlite3$||')")"
  printf '%sriporto %s all istante %s%s\n' "$BOLD" "$SCENARIO" "$VFOOT_FAKE_NOW" "$X"
  # Fermare e' obbligatorio, non cortese: su Windows un server acceso tiene aperto
  # il file e la copia fallisce, e su un sistema che la lascia passare si
  # sovrascriverebbe una banca dati sotto i piedi di chi ci sta scrivendo.
  cmd_stop
  db=$(db_path)
  [ -n "$db" ] || die "banca dati non trovata"
  # I giornali di SQLite sopravvivono alla copia e riporterebbero dentro il file
  # appena ripristinato le scritture della serata che stiamo buttando via.
  rm -f "$db-wal" "$db-shm"
  cp "$snap" "$db" || die "ripristino fallito"
  say "banca dati ripristinata dall istantanea"
  # L'istantanea e' di quando e' stata presa, quindi ha lo SCHEMA di allora: una
  # migrazione arrivata dopo la renderebbe incompatibile col codice di adesso, e il
  # sintomo (`no such column: ...`) arriverebbe non al ripristino ma alla prima
  # pagina aperta, che e' il momento peggiore per scoprirlo. Migrare qui costa un
  # secondo quando non c'e' niente da fare.
  ( cd "$REPO/vfoot-backend/src" && "$PY" manage.py migrate --noinput >/dev/null ) \
    || die "migrazione dell istantanea fallita"
  cmd_start
}

# Con che utente si entra, e che cosa si trova dentro. Senza questa riga la lega
# c'e' ma e' invisibile: si finisce a chiedersi se il banco l'abbia seminata, e la
# risposta sta a tre query di distanza in una shell Django.
say_league() {
  # Dentro `src`, e non da dove capita: uno script passato per stdin mette in
  # sys.path la cartella CORRENTE, non quella di manage.py, quindi dalla radice del
  # repo `config.settings` non si importa. Cosi' e' gia' fallito una volta -- e in
  # silenzio, perche' l'errore finiva in /dev/null insieme al resto: la funzione
  # veniva chiamata, non stampava niente, e sembrava che la lega non ci fosse.
  local out
  out=$( cd "$REPO/vfoot-backend/src" && "$PY" - "$SCENARIO" <<'EOF' 2>&1
import os, sys, django
os.environ.setdefault("DJANGO_SETTINGS_MODULE", "config.settings")
django.setup()
from vfoot.management.commands.simulate_scenario import SCENARIOS
from vfoot.models import FantasyCompetition, FantasyLeague, FantasyTeam

sc = SCENARIOS.get(sys.argv[1])
if sc is None or not sc.league_name:
    raise SystemExit(0)
leagues = list(FantasyLeague.objects.filter(name=sc.league_name).select_related("owner"))
if not leagues:
    print("  lega     non ancora seminata: ./vfoot-sim build %s" % sys.argv[1])
    raise SystemExit(0)
for lg in leagues:
    comps = list(FantasyCompetition.objects.filter(league=lg).values_list("name", flat=True))
    print("  lega      %s  (id %d)" % (lg.name, lg.id))
    print("  entra come  %s   squadra: %s" % (
        lg.owner.username,
        (FantasyTeam.objects.filter(league=lg, manager__user=lg.owner)
         .values_list("name", flat=True).first() or "(nessuna)")))
    print("  competizioni  %s" % (", ".join(comps) if comps else "(nessuna)"))
EOF
  )
  # Un fallimento si DICE. Questa e' una riga informativa e non deve fermare un
  # avvio, ma "non stampa niente" e "la lega non c'e'" devono restare due cose
  # distinguibili a schermo, che e' precisamente cio' che prima non erano.
  if [ -n "$out" ]; then
    printf '%s\n' "$out"
  else
    printf '%s  lega      non sono riuscito a leggerla dalla banca dati%s\n' "$DIM" "$X"
  fi
}

cmd_status() {
  printf '%sporte%s\n' "$BOLD" "$X"
  port_busy "$BACK_PORT" && say "backend   in ascolto sulla $BACK_PORT" || say "backend   fermo"
  port_busy "$FRONT_PORT" && say "frontend  in ascolto sulla $FRONT_PORT" || say "frontend  fermo"
  port_busy "$REDIS_PORT" && say "redis     in ascolto sulla $REDIS_PORT" \
    || say "redis     fermo (la pagina non si aggiorna da sola)"
  printf '%sorologio del server%s\n' "$BOLD" "$X"
  if port_busy "$BACK_PORT"; then
    # L'intestazione c'e' SOLO quando l'orologio e' spostato: la sua assenza e'
    # essa stessa la risposta, ed e' il controllo che dice se il processo acceso
    # e' quello simulato o quello di tutti i giorni.
    local now
    now=$("$PY" - "$BACK_PORT" <<'EOF' 2>/dev/null
import sys, urllib.request
try:
    r = urllib.request.urlopen(f"http://localhost:{sys.argv[1]}/api/v1/leagues", timeout=4)
    print(r.headers.get("X-Vfoot-Now") or "")
except Exception as exc:
    print(getattr(exc, "headers", {}).get("X-Vfoot-Now", "") if hasattr(exc, "headers") else "")
EOF
)
    if [ -n "$now" ]; then say "SIMULATO  $now"; else say "reale     (nessuna intestazione X-Vfoot-Now)"; fi
    # Guardato dall'istante del SERVER, non da quello che questo processo si
    # esporterebbe: `status` puo' essere chiamato senza argomenti mentre gira un
    # altro scenario, e il confronto va fatto con l'orologio vero della cosa
    # accesa. Solo se e' simulato: su un orologio reale una stagione del 2027 e'
    # tutta nel futuro, e il controllo suonerebbe l'allarme su ogni riga.
    # Lo scenario non si sa quale sia -- lo si lascia da riempire.
    [ -n "$now" ] && check_drift "$now" "<scenario>"
  else
    say "n/d       backend fermo"
  fi
  # `|| true`: un comando che RIFERISCE non deve uscire con errore solo perche' non
  # c'e' niente da riferire. Senza, `status` a simulazione ferma tornava 1, e uno
  # script che lo interrogasse l'avrebbe letto come un guasto.
  if [ -s "$PIDFILE" ]; then
    printf '%s  avviati da questo script: %s pid  (log: %s)%s\n' \
      "$DIM" "$(wc -l < "$PIDFILE" | tr -d ' ')" "$LOGDIR" "$X"
  fi
  return 0
}

cmd_stop() {
  local n=0
  if [ -s "$PIDFILE" ]; then
    while read -r p; do
      [ -n "$p" ] || continue
      kill "$p" 2>/dev/null && n=$((n + 1))
    done < "$PIDFILE"
    : > "$PIDFILE"
  fi
  # I pid dei figli avviati con nohup non bastano su Windows, dove il processo
  # vero e' un nipote: si chiude anche per porta.
  kill_port "$BACK_PORT" || true
  if [ -f "$LOGDIR/started-frontend" ]; then
    kill_port "$FRONT_PORT" || true
    rm -f "$LOGDIR/started-frontend"
  elif port_busy "$FRONT_PORT"; then
    say "frontend  lasciato acceso: non l'ha avviato questo script"
  fi
  if [ -f "$LOGDIR/started-redis" ]; then
    ct=$(container_cmd) && "$ct" rm -f "$REDIS_NAME" >/dev/null 2>&1
    rm -f "$LOGDIR/started-redis"
    say "redis     fermato"
  fi
  # Il cron non ascolta su nessuna porta, quindi va cercato per riga di comando.
  if command -v taskkill.exe >/dev/null 2>&1; then
    "$PY" - <<'EOF' 2>/dev/null || true
import subprocess
out = subprocess.run(["wmic", "process", "where", "name='python.exe'",
                      "get", "ProcessId,CommandLine", "/format:csv"],
                     capture_output=True, text=True).stdout
for line in out.splitlines():
    if "tick_loop" in line:
        pid = line.strip().rsplit(",", 1)[-1]
        if pid.isdigit():
            subprocess.run(["taskkill.exe", "/PID", pid, "/F"], capture_output=True)
EOF
  else
    pkill -f "manage.py tick_loop" 2>/dev/null || true
  fi
  printf '%sfermato%s (%s processi chiusi per pid)\n' "$OK" "$X" "$n"
}

usage() {
  # Fino alla riga che chiude l'elenco, non fino a un numero di riga fisso: l'elenco
  # cresce, e il numero fisso non cresce con lui -- teneva fuori build, reset e
  # resume, cioe' meta' dei comandi, senza che niente lo segnalasse.
  awk 'NR>=3 { if ($0=="#" && seen) exit; if (/vfoot-sim/) seen=1
               sub(/^#/,""); sub(/^ /,""); print }' "${BASH_SOURCE[0]}"
}

# --- argomenti ------------------------------------------------------------
CMD=""
while [ $# -gt 0 ]; do
  case "$1" in
    --at)   AT="${2:-}"; shift 2 ;;
    --lan)  LAN=1; shift ;;
    --owner) OWNER="${2:-}"; shift 2 ;;
    --cup)  CUP=1; shift ;;
    -h|--help|help) usage; exit 0 ;;
    start|stop|status|build|reset|resume) CMD="$1"; shift ;;
    *)      SCENARIO="$1"; shift ;;
  esac
done

# Chieste a un comando che NON semina: sarebbero ignorate, e in silenzio. Sono le
# due opzioni che si danno pensando "adesso la lega diventa di jije", quindi
# lasciarle caere senza dire niente e' il modo migliore per far credere di aver
# fatto una cosa che non e' successa.
if [ -n "$OWNER$CUP" ] && [ "${CMD:-start}" != "build" ]; then
  die "--owner e --cup valgono solo quando si SEMINA, cioe' con \`build\`:
  ./vfoot-sim build $SCENARIO${OWNER:+ --owner $OWNER}${CUP:+ --cup}
  Un avvio non ricostruisce la lega, quindi non potrebbe cambiarne il proprietario."
fi

case "${CMD:-start}" in
  start)  cmd_start ;;
  build)  cmd_build ;;
  reset)  cmd_reset ;;
  resume) cmd_resume ;;
  status) cmd_status ;;
  stop)   cmd_stop ;;
  *)      usage; exit 1 ;;
esac
