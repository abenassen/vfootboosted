#!/bin/sh
# Adapter: Claude.  stdin = the context JSON.  stdout = ONLY the proposal JSON.
# Exit != 0 means the pass failed (the caller records it and carries on).
#
# Runs as `vfoot`, in the checkout, with NO sudo. It can read, search, run the test
# suite and create a branch. It cannot restart anything, cannot deploy, and has no
# entry in sudoers — the power lives entirely in the executor on the other side of
# the JSON contract.
#
# The tool list is the second reason this is safe and the first reason it is cheap:
# no WebFetch, no WebSearch, no network. The agent reasons about a digested report,
# never about bytes fetched from the site that just broke.
# WHERE IT WORKS: a worktree of its own, never the live checkout. A `git switch -c`
# in /srv/vfoot-app would move the files the running server reads; here it moves
# nothing anyone serves. The branch it creates lives in the shared repository, so
# the executor finds it by name (`maintenance._validate_apply_patch`) and tests it in
# a worktree of ITS own before merging. Each pass starts from the current `main`.
#
# The model: Sonnet 5.5 at effort `high` (decided 22/10/2026). The work is reading a
# fault the deterministic layer has already named, choosing among four closed
# actions and, at most, a one-line patch; the hard cases of the season (the TM WAF,
# the refused TLS fingerprint) were out of reach for lack of TOOLS, not of
# intelligence. VFOOT_AGENT_MODEL / VFOOT_AGENT_EFFORT override both (the Kimi
# adapter sets the first and empties the second).
#
# Authentication: either ANTHROPIC_API_KEY (pay per use) or CLAUDE_CODE_OAUTH_TOKEN
# from `claude setup-token` (the subscription). Not both: the API key wins, and the
# passes would be billed per use without anything saying so.
set -eu

REPO=/srv/vfoot-app
# Both under /srv/vfoot-data, which vfoot owns (/srv itself is root's). The CLI's
# own state goes there too: vfoot's HOME is the checkout, and ~/.claude would end up
# as an untracked directory inside the repository the server runs from.
WORK="${VFOOT_AGENT_WORKTREE:-/srv/vfoot-data/agent-work}"
export CLAUDE_CONFIG_DIR="${CLAUDE_CONFIG_DIR:-/srv/vfoot-data/agent-claude}"

if [ ! -e "$WORK/.git" ]; then
    git -C "$REPO" worktree add --detach "$WORK" main >/dev/null 2>&1 || exit 1
fi
cd "$WORK" || exit 1
git checkout --quiet --detach main || exit 1
git reset --quiet --hard main && git clean -qfd || exit 1

MODEL="${VFOOT_AGENT_MODEL:-claude-sonnet-5-5}"
EFFORT="${VFOOT_AGENT_EFFORT-high}"

# Git: only what building a fix/ branch needs. No push, no config, no remote, no
# reset, no checkout of somebody else's ref — the executor does the merging.
TOOLS='Read,Grep,Glob,Edit,Write'
TOOLS="$TOOLS,Bash(git switch -c fix/*),Bash(git add *),Bash(git commit *)"
TOOLS="$TOOLS,Bash(git diff*),Bash(git log*),Bash(git show *),Bash(git status*)"
TOOLS="$TOOLS,Bash(*manage.py test*)"

exec claude -p "$(cat)" \
    --model "$MODEL" \
    ${EFFORT:+--effort "$EFFORT"} \
    --append-system-prompt "$(cat "$REPO/vfoot-backend/deploy/agent/prompt.md")" \
    --allowedTools "$TOOLS" \
    --output-format json
