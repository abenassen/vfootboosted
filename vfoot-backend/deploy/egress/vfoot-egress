#!/bin/sh
# Fixed entry point that the unprivileged `vfoot` user is allowed to run as root
# via sudo (see vfoot-egress.sudoers). It runs the egress, which needs root for the
# netns + WireGuard tunnel. Args pass straight through
# (fetch / schedule / tm-squads / refill / status / probe). The sudoers rule names
# only this path, so a new subcommand needs no sudoers change.
# Install at /usr/local/sbin/vfoot-egress.
exec /srv/vfoot-app/vfoot-backend/.venv/bin/python \
     /srv/vfoot-app/vfoot-backend/egress/sofascore_egress.py "$@"
